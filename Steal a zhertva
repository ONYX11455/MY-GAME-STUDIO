<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Thief Master: Unbreakable Edition</title>
    <style>
        body { margin: 0; background: #000; color: white; font-family: sans-serif; overflow: hidden; touch-action: none; user-select: none; }
        canvas { display: block; width: 100vw; height: 100vh; }
        
        /* UI */
        #ui { position: absolute; top: 10px; left: 10px; pointer-events: none; z-index: 100; }
        .stat { background: rgba(0,0,0,0.8); padding: 10px 15px; border-radius: 10px; border: 1px solid #444; margin-bottom: 5px; pointer-events: auto; }
        #money-display { color: #4ecca3; font-size: 22px; font-weight: bold; cursor: pointer; }
        
        #buy-btn { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); background: #4ecca3; color: #1a1a2e; border: 3px solid #fff; padding: 15px 30px; font-weight: bold; border-radius: 15px; cursor: pointer; z-index: 100; }
        #menu-btn { position: absolute; top: 10px; right: 10px; background: #e94560; color: white; padding: 10px 20px; border: 2px solid #fff; font-weight: bold; cursor: pointer; z-index: 100; border-radius: 8px; }

        /* ПАНЕЛИ */
        .panel { position: absolute; right: 0; top: 0; width: 300px; height: 100%; background: #1a1a2e; border-left: 5px solid #e94560; display: none; z-index: 200; flex-direction: column; }
        .tabs { display: flex; background: #111; margin-top: 50px; flex-wrap: wrap; }
        .tab-btn { flex: 1; padding: 10px; font-size: 10px; border: none; background: none; color: #888; cursor: pointer; border-bottom: 2px solid transparent; }
        .tab-btn.active { color: #e94560; border-bottom-color: #e94560; }
        .content { flex: 1; overflow-y: auto; padding: 15px; }
        .card { background: #222; padding: 10px; margin-bottom: 10px; border-radius: 8px; border: 1px solid #444; }
        .btn { background: #4ecca3; border: none; width: 100%; padding: 10px; font-weight: bold; cursor: pointer; border-radius: 5px; margin-top: 5px; }
        .close-btn { position: absolute; top: 10px; right: 10px; background: #e94560; border: none; color: white; width: 30px; height: 30px; cursor: pointer; border-radius: 50%; }

        /* КОЛЕСО */
        #wheel-box { width: 200px; height: 200px; margin: 20px auto; position: relative; border: 4px solid #fff; border-radius: 50%; background: #fff; }
        #wheel-canvas { width: 100%; height: 100%; transition: transform 4s cubic-bezier(0.1, 0, 0.2, 1); }
        #wheel-arrow { position: absolute; top: -15px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 15px solid transparent; border-right: 15px solid transparent; border-top: 30px solid #e94560; z-index: 10; }

        #global-msg { position: fixed; top: 20%; left: 50%; transform: translateX(-50%); background: #e94560; padding: 20px; border: 3px solid #fff; z-index: 1000; display: none; text-align: center; width: 80%; font-weight: bold; border-radius: 15px; }
    </style>
</head>
<body onclick="initAudio()">

<canvas id="gameCanvas"></canvas>
<div id="global-msg"></div>

<div id="ui">
    <div class="stat" id="money-display" onclick="adminStep()">💰 <span id="m-val">150</span> $</div>
    <div class="stat" style="color:#f1c40f">⚡ <span id="p-val">0</span> PP</div>
    <div class="stat" style="font-size:12px">ДОХОД: <span id="inc-val">+0</span>/с</div>
</div>

<button id="menu-btn" onclick="toggleMenu()">МЕНЮ</button>
<button id="buy-btn" onclick="buyVictim()">КУПИТЬ ЖЕРТВУ (150$)</button>

<!-- МЕНЮ -->
<div id="menu-panel" class="panel">
    <button class="close-btn" onclick="toggleMenu()">×</button>
    <div class="tabs">
        <button class="tab-btn active" id="t-gang" onclick="switchTab('gang')">БАНДА</button>
        <button class="tab-btn" id="t-luck" onclick="switchTab('luck')">УДАЧА</button>
        <button class="tab-btn" id="t-bg" onclick="switchTab('bg')">ФОНЫ</button>
    </div>
    <div id="menu-content" class="content"></div>
</div>

<!-- АДМИНКА -->
<div id="admin-panel" class="panel" style="border-left-color: #f1c40f;">
    <button class="close-btn" onclick="closeAdmin()">×</button>
    <h2 style="color:#f1c40f; padding:15px; margin-top:40px;">ADMIN 777</h2>
    <div class="content">
        <button class="btn" onclick="money+=1000000; updateUI();">ВЗЛОМ: +1M $</button>
        <button class="btn" onclick="power+=50000; updateUI();">ВЗЛОМ: +50k PP</button>
        <hr>
        <input type="text" id="adm-msg" placeholder="Глобальное сообщение..." style="width:100%; padding:10px; margin-bottom:5px;">
        <button class="btn" style="background:#e94560; color:white" onclick="sendGlobal()">ОТПРАВИТЬ ВСЕМ</button>
    </div>
</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
let w, h, audioCtx;
function resize() { w = canvas.width = window.innerWidth; h = canvas.height = window.innerHeight; }
window.addEventListener('resize', resize); resize();

// Игровые данные
let money = 150, power = 0, income = 0, admClicks = 0;
let victims = [], gang = [], isSpinning = false, totalRot = 0;
let currentTab = 'gang', activeBg = 'black';

let player = { x: 200, y: 200, r: 20, s: 7 };
let joy = { active: false, x: 0, y: 0, sx: 0, sy: 0 };

const bgConfig = {
    black: { n: "ТЬМА", c: "#050505" },
    grid: { n: "СЕТКА", c: "#001a1a" }
};

function initAudio() { if(!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
function sfx(f, d) { if(!audioCtx) return; let o = audioCtx.createOscillator(); let g = audioCtx.createGain(); o.frequency.value = f; g.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime+d); o.connect(g); g.connect(audioCtx.destination); o.start(); o.stop(audioCtx.currentTime+d); }

// Системные функции
function adminStep() { admClicks++; if(admClicks >= 5){ if(prompt("CODE?")==="777") document.getElementById('admin-panel').style.display='flex'; admClicks=0; } }
function closeAdmin() { document.getElementById('admin-panel').style.display='none'; }
function sendGlobal() { 
    let m = document.getElementById('adm-msg').value; 
    let b = document.getElementById('global-msg'); 
    b.innerText = "АДМИН: " + m; b.style.display = 'block'; 
    sfx(400, 0.5); setTimeout(()=>b.style.display='none', 5000); 
}

function toggleMenu() { document.getElementById('menu-panel').style.display = (document.getElementById('menu-panel').style.display==='flex')?'none':'flex'; renderTab(); }
function switchTab(t) { 
    currentTab = t; 
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('t-'+t).classList.add('active');
    renderTab(); 
}

function renderTab() {
    const cont = document.getElementById('menu-content'); cont.innerHTML = '';
    if(currentTab === 'gang') {
        cont.innerHTML = `<h3>БАНДА (+${income}$/с)</h3>`;
        gang.forEach((t, i) => cont.innerHTML += `<div class="card">👤 ${t.n} (Доход: ${t.inc}$)<br><button class="btn" onclick="upThief(${i})">АПГРЕЙД (${t.lvl*100} PP)</button></div>`);
        if(!gang.length) cont.innerHTML += "Ловите жертв на карте!";
    } else if(currentTab === 'luck') {
        cont.innerHTML = `<div id="wheel-box"><div id="wheel-arrow"></div><canvas id="wheel-canvas" width="300" height="300"></canvas></div><button class="btn" onclick="spin()">КРУТИТЬ (500$)</button>`;
        setTimeout(drawWheel, 50);
    } else if(currentTab === 'bg') {
        for(let k in bgConfig) cont.innerHTML += `<div class="card"><b>${bgConfig[k].n}</b><button class="btn" onclick="activeBg='${k}'; renderTab()">ВКЛЮЧИТЬ</button></div>`;
    }
}

function upThief(i) {
    let t = gang[i]; let cost = t.lvl * 100;
    if(power >= cost) { power -= cost; t.lvl++; t.inc += 15; income = gang.reduce((s,x)=>s+x.inc,0); updateUI(); renderTab(); sfx(800,0.1); }
}

function drawWheel() {
    let cv = document.getElementById('wheel-canvas'); if(!cv) return;
    let x = cv.getContext('2d'); x.clearRect(0,0,300,300);
    const p = ["100 PP", "500$", "250 PP", "1000$", "50 PP", "2000$"];
    for(let i=0; i<6; i++) {
        x.fillStyle = i%2?'#e94560':'#1a1a2e';
        x.beginPath(); x.moveTo(150,150); x.arc(150,150,150,i*Math.PI/3,(i+1)*Math.PI/3); x.fill();
        x.save(); x.translate(150,150); x.rotate(i*Math.PI/3 + Math.PI/6);
        x.fillStyle="white"; x.font="bold 14px Arial"; x.fillText(p[i], 60, 5); x.restore();
    }
}

function spin() {
    if(isSpinning || money < 500) return;
    money -= 500; isSpinning = true;
    totalRot += 1440 + Math.random()*360;
    document.getElementById('wheel-canvas').style.transform = `rotate(${totalRot}deg)`;
    setTimeout(()=>{ isSpinning=false; power+=500; updateUI(); sfx(1000, 0.2); }, 4000);
}

function buyVictim() {
    if(money >= 150) {
        money -= 150;
        victims.push({x: Math.random()*w, y: Math.random()*h, vx: (Math.random()-0.5)*5, vy: (Math.random()-0.5)*5, s: 3});
        updateUI(); sfx(400, 0.1);
    }
}

function updateUI() { 
    document.getElementById('m-val').innerText = Math.floor(money); 
    document.getElementById('p-val').innerText = power; 
    document.getElementById('inc-val').innerText = "+" + income; 
}

// УПРАВЛЕНИЕ
canvas.addEventListener('pointerdown', e => { joy.active=true; joy.sx=e.clientX; joy.sy=e.clientY; joy.x=0; joy.y=0; });
canvas.addEventListener('pointermove', e => { if(joy.active){ joy.x = e.clientX-joy.sx; joy.y = e.clientY-joy.sy; }});
window.addEventListener('pointerup', () => joy.active=false);

function loop() {
    // Фон
    ctx.fillStyle = bgConfig[activeBg].c; ctx.fillRect(0,0,w,h);
    if(activeBg==='grid') {
        ctx.strokeStyle="rgba(0,255,255,0.1)";
        for(let i=0;i<w;i+=50){ ctx.beginPath();ctx.moveTo(i,0);ctx.lineTo(i,h);ctx.stroke(); }
        for(let j=0;j<h;j+=50){ ctx.beginPath();ctx.moveTo(0,j);ctx.lineTo(w,j);ctx.stroke(); }
    }

    // Игрок
    if(joy.active) {
        let dist = Math.hypot(joy.x, joy.y);
        if(dist > 5) {
            let a = Math.atan2(joy.y, joy.x);
            player.x += Math.cos(a)*player.s;
            player.y += Math.sin(a)*player.s;
        }
    }
    // Границы игрока
    player.x = Math.max(player.r, Math.min(w-player.r, player.x));
    player.y = Math.max(player.r, Math.min(h-player.r, player.y));

    // Жертвы
    victims.forEach((v, i) => {
        let d = Math.hypot(player.x - v.x, player.y - v.y);
        
        // ИИ: убегание
        if(d < 150) {
            let a = Math.atan2(v.y - player.y, v.x - player.x);
            v.vx = Math.cos(a)*v.s*1.5; v.vy = Math.sin(a)*v.s*1.5;
        }
        v.x += v.vx; v.y += v.vy;

        // Границы жертв
        if(v.x < 15 || v.x > w-15) v.vx *= -1;
        if(v.y < 15 || v.y > h-15) v.vy *= -1;
        v.x = Math.max(15, Math.min(w-15, v.x));
        v.y = Math.max(15, Math.min(h-15, v.y));

        ctx.fillStyle = "#4ecca3"; ctx.beginPath(); ctx.arc(v.x, v.y, 15, 0, 7); ctx.fill();
        ctx.fillStyle="black"; ctx.beginPath(); ctx.arc(v.x-5, v.y-3, 2, 0, 7); ctx.arc(v.x+5, v.y-3, 2, 0, 7); ctx.fill();
        ctx.strokeStyle="black"; ctx.beginPath(); ctx.arc(v.x, v.y+3, 5, 0, Math.PI); ctx.stroke();

        if(d < 35) {
            gang.push({n: "ВОР", inc: 15, lvl: 1});
            income = gang.reduce((s,x)=>s+x.inc, 0);
            victims.splice(i, 1); sfx(1100, 0.05); updateUI();
        }
    });

    // Отрисовка игрока
    ctx.fillStyle = "#e94560"; ctx.beginPath(); ctx.arc(player.x, player.y, player.r, 0, 7); ctx.fill();
    ctx.strokeStyle="white"; ctx.lineWidth=3; ctx.stroke();

    money += income / 60;
    updateUI();
    requestAnimationFrame(loop);
}
updateUI(); loop();
</script>
</body>
</html>
